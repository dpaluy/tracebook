<div class="tb-detail-page">
  <%# Header with back navigation %>
  <nav class="tb-detail-nav">
    <%= link_to interactions_path, class: "tb-back-link" do %>
      ← Back to Interactions
    <% end %>
  </nav>

  <%# Title section %>
  <header class="tb-detail-header">
    <div class="tb-detail-title-row">
      <h1>Interaction #<%= @interaction.id %></h1>
      <span class="tb-detail-timestamp"><%= @interaction.created_at.strftime("%b %d, %Y at %H:%M:%S") %></span>
    </div>
    <div class="tb-detail-subtitle">
      <span class="tb-provider-badge"><%= @interaction.provider.upcase %></span>
      <span class="tb-model-name"><%= @interaction.model %></span>
    </div>
  </header>

  <%# Metrics cards %>
  <div class="tb-metrics-grid">
    <div class="tb-metric-card">
      <span class="tb-metric-label">Status</span>
      <div class="tb-metric-value">
        <%= status_badge(@interaction.status) %>
      </div>
    </div>
    <div class="tb-metric-card">
      <span class="tb-metric-label">Latency</span>
      <div class="tb-metric-value <%= latency_class(@interaction.latency_ms) %>">
        <%= latency_display(@interaction.latency_ms) %>
      </div>
    </div>
    <div class="tb-metric-card">
      <span class="tb-metric-label">Tokens (in/out)</span>
      <div class="tb-metric-value">
        <%= token_breakdown(@interaction) %>
      </div>
    </div>
    <div class="tb-metric-card">
      <span class="tb-metric-label">Cost</span>
      <div class="tb-metric-value">
        <%= cents_to_human(@interaction.cost_total_cents) %>
      </div>
    </div>
    <% if @interaction.actor_type.present? %>
      <div class="tb-metric-card">
        <span class="tb-metric-label">Actor</span>
        <div class="tb-metric-value">
          <%= @interaction.actor_type.demodulize %>#<%= @interaction.actor_id %>
        </div>
      </div>
    <% end %>
  </div>

  <%# Review section %>
  <section class="tb-review-section">
    <div class="tb-review-header">
      <h2>Review</h2>
      <span class="tb-current-state">Current: <%= review_badge(@interaction.review_state) %></span>
    </div>
    <div class="tb-review-actions">
      <% TraceBook::Interaction.review_states.keys.each do |state| %>
        <% next if state == @interaction.review_state %>
        <%= button_to state.titleize,
            review_interaction_path(@interaction),
            params: { review_state: state },
            method: :post,
            class: "tb-review-btn tb-review-btn-#{state}" %>
      <% end %>
    </div>
  </section>

  <%# Comments section %>
  <section class="tb-comments-section">
    <h2>Comments (<%= @interaction.comments.count %>)</h2>
    <% if @interaction.comments.any? %>
      <div class="tb-comments-list">
        <% @interaction.comments.each do |comment| %>
          <div class="tb-comment">
            <div class="tb-comment-meta">
              <span class="tb-comment-author"><%= comment.author %></span>
              <span class="tb-comment-time"><%= comment.created_at.strftime("%b %d, %Y at %H:%M") %></span>
            </div>
            <div class="tb-comment-body">
              <%= simple_format(comment.body) %>
            </div>
          </div>
        <% end %>
      </div>
    <% end %>
    <%= form_with model: [@interaction, Tracebook::Comment.new], url: interaction_comments_path(@interaction), class: "tb-comment-form" do |f| %>
      <%= f.text_area :body,
          placeholder: "Add a comment...",
          class: "tb-comment-input",
          rows: 2 %>
      <%= f.submit "Add Comment", class: "tb-btn-secondary" %>
    <% end %>
  </section>

  <%# Payload sections %>
  <div class="tb-payload-sections">
    <% request_payload = payload_for(@interaction, :request) %>
    <% request_json = formatted_payload(request_payload, @interaction.request_text) %>
    <section class="tb-payload-section tb-collapsed" data-controller="json-viewer" data-json-viewer-collapsed-value="true">
      <header class="tb-payload-header" data-action="click->json-viewer#toggle">
        <div class="tb-payload-title">
          <span class="tb-chevron" data-json-viewer-target="icon">▶</span>
          <span>Request</span>
        </div>
        <button type="button" class="tb-copy-btn" data-action="click->json-viewer#copy" data-json-viewer-target="copyBtn" data-payload="<%= CGI.escapeHTML(request_json.to_s) %>">
          <span data-json-viewer-target="copyText">Copy</span>
        </button>
      </header>
      <div class="tb-payload-content" data-json-viewer-target="content" style="display: none;">
        <pre class="tb-code"><code><%= syntax_highlight_json(request_json) %></code></pre>
      </div>
    </section>

    <% response_payload = payload_for(@interaction, :response) %>
    <% response_json = formatted_payload(response_payload, @interaction.response_text) %>
    <section class="tb-payload-section tb-collapsed" data-controller="json-viewer" data-json-viewer-collapsed-value="true">
      <header class="tb-payload-header" data-action="click->json-viewer#toggle">
        <div class="tb-payload-title">
          <span class="tb-chevron" data-json-viewer-target="icon">▶</span>
          <span>Response</span>
        </div>
        <button type="button" class="tb-copy-btn" data-action="click->json-viewer#copy" data-json-viewer-target="copyBtn" data-payload="<%= CGI.escapeHTML(response_json.to_s) %>">
          <span data-json-viewer-target="copyText">Copy</span>
        </button>
      </header>
      <div class="tb-payload-content" data-json-viewer-target="content" style="display: none;">
        <pre class="tb-code"><code><%= syntax_highlight_json(response_json) %></code></pre>
      </div>
    </section>

    <% if @interaction.metadata.present? && @interaction.metadata != {} %>
      <section class="tb-payload-section tb-collapsed" data-controller="json-viewer" data-json-viewer-collapsed-value="true">
        <header class="tb-payload-header" data-action="click->json-viewer#toggle">
          <div class="tb-payload-title">
            <span class="tb-chevron" data-json-viewer-target="icon">▶</span>
            <span>Metadata</span>
          </div>
        </header>
        <div class="tb-payload-content" data-json-viewer-target="content" style="display: none;">
          <pre class="tb-code"><code><%= syntax_highlight_json(formatted_payload(@interaction.metadata, "{}")) %></code></pre>
        </div>
      </section>
    <% end %>
  </div>
</div>
