<div class="tb-container">
  <nav class="tb-breadcrumbs">
    <%= link_to "← Back", interactions_path %>
  </nav>

  <header class="tb-header">
    <h1>Interaction <%= @interaction.id %></h1>
    <div class="tb-meta-grid">
      <div><span>Provider</span><strong><%= @interaction.provider %></strong></div>
      <div><span>Model</span><strong><%= @interaction.model %></strong></div>
      <div><span>Context</span><strong><%= trackable_link(@interaction) %></strong></div>
      <div><span>Status</span><strong><%= status_badge(@interaction.status) %></strong></div>
      <div><span>Review</span><strong><%= review_badge(@interaction.review_state) %></strong></div>
      <div><span>Latency</span><strong><%= latency_display(@interaction.latency_ms) %></strong></div>
      <div><span>Tokens (in/out)</span><strong><%= token_breakdown(@interaction) %></strong></div>
      <div><span>Cost</span><strong><%= cents_to_human(@interaction.cost_total_cents) %></strong></div>
    </div>
  </header>

  <% request_payload = payload_for(@interaction, :request) %>
  <section class="tb-section" data-controller="json-viewer" data-json-viewer-collapsed-value="true">
    <h2 class="tb-section-header" data-action="click->json-viewer#toggle">
      <span class="tb-toggle-icon" data-json-viewer-target="icon">▶</span>
      Request
    </h2>
    <div class="tb-section-content" data-json-viewer-target="content">
      <pre><%= formatted_payload(request_payload, @interaction.request_text) %></pre>
    </div>
  </section>

  <% response_payload = payload_for(@interaction, :response) %>
  <section class="tb-section" data-controller="json-viewer" data-json-viewer-collapsed-value="false">
    <h2 class="tb-section-header" data-action="click->json-viewer#toggle">
      <span class="tb-toggle-icon" data-json-viewer-target="icon">▼</span>
      Response
    </h2>
    <div class="tb-section-content" data-json-viewer-target="content">
      <pre><%= formatted_payload(response_payload, @interaction.response_text) %></pre>
    </div>
  </section>

  <section class="tb-section" data-controller="json-viewer" data-json-viewer-collapsed-value="true">
    <h2 class="tb-section-header" data-action="click->json-viewer#toggle">
      <span class="tb-toggle-icon" data-json-viewer-target="icon">▶</span>
      Metadata
    </h2>
    <div class="tb-section-content" data-json-viewer-target="content">
      <pre><%= formatted_payload(@interaction.metadata, "{}") %></pre>
    </div>
  </section>

  <section class="tb-section">
    <%= form_with url: review_interaction_path(@interaction), method: :post, class: "tb-review-form" do %>
      <div>
        <%= label_tag :review_state, "Review State" %>
        <%= select_tag :review_state, options_for_select(TraceBook::Interaction.review_states.keys, @interaction.review_state) %>
      </div>
      <%= submit_tag "Update Review" %>
    <% end %>
  </section>
</div>
