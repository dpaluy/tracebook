<div class="tb-container">
  <header class="tb-header">
    <div class="tb-breadcrumb">
      <%= link_to "&larr; Back to Actors".html_safe, actors_path, class: "tb-back-link" %>
    </div>
    <h1><%= actor_display_name(@actor_type, @actor_id) %></h1>
    <div class="tb-kpis">
      <div class="tb-kpi">
        <span>Sessions</span>
        <strong><%= number_with_delimiter(@kpis[:sessions_count]) %></strong>
      </div>
      <div class="tb-kpi">
        <span>Interactions</span>
        <strong><%= number_with_delimiter(@kpis[:interactions_count]) %></strong>
      </div>
      <div class="tb-kpi">
        <span>Total Tokens</span>
        <strong><%= number_with_delimiter(@kpis[:total_tokens]) %></strong>
      </div>
      <div class="tb-kpi">
        <span>Total Cost</span>
        <strong><%= cents_to_human(@kpis[:total_cost_cents]) %></strong>
      </div>
    </div>
  </header>

  <nav class="tb-nav-tabs">
    <%= link_to "Actors", actors_path, class: "tb-nav-tab" %>
    <%= link_to "All Interactions", interactions_path, class: "tb-nav-tab" %>
  </nav>

  <section class="tb-table-wrapper">
    <h2 class="tb-section-title">LLM Sessions</h2>
    <turbo-frame id="sessions_table">
      <table class="tb-table">
        <thead>
          <tr>
            <th>Context</th>
            <th>Model</th>
            <th>Interactions</th>
            <th>Tokens</th>
            <th>Cost</th>
            <th>Review</th>
            <th>Last Activity</th>
          </tr>
        </thead>
        <tbody>
          <% @sessions.each do |session| %>
            <tr>
              <td>
                <%= link_to actor_session_path(type: type_to_param(@actor_type), id: @actor_id, session_id: session.session_id) do %>
                  <%= session.context_label %>
                <% end %>
              </td>
              <td><%= session.model %></td>
              <td><%= session.interactions_count %></td>
              <td><%= number_with_delimiter(session.total_tokens) %></td>
              <td><%= session.formatted_cost %></td>
              <td><%= session_review_badge(session) %></td>
              <td><%= session.last_activity&.strftime("%Y-%m-%d %H:%M") %></td>
            </tr>
          <% end %>
        </tbody>
      </table>
      <% if @pagination[:total_pages] > 1 %>
        <nav class="tb-pagination" aria-label="Sessions pagination">
          <% if @pagination[:prev_page] %>
            <%= link_to "← Previous", actor_path(type: type_to_param(@actor_type), id: @actor_id, page: @pagination[:prev_page]), class: "tb-page-link", data: { turbo_frame: "sessions_table" } %>
          <% end %>
          <span class="tb-page-info">Page <%= @pagination[:current_page] %> of <%= @pagination[:total_pages] %></span>
          <% if @pagination[:next_page] %>
            <%= link_to "Next →", actor_path(type: type_to_param(@actor_type), id: @actor_id, page: @pagination[:next_page]), class: "tb-page-link", data: { turbo_frame: "sessions_table" } %>
          <% end %>
        </nav>
      <% end %>
    </turbo-frame>
  </section>
</div>
